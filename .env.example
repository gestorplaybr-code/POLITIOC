# ==========================================================================
# Enquete Política — modelo de variáveis de ambiente
# --------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com os valores do SEU backend.
# Este arquivo contém apenas NOMES e explicações — nunca versione valores.
#
# Regra da fronteira cliente/servidor:
#   VITE_*  -> embutido no pacote enviado ao navegador. NUNCA coloque segredo.
#   sem VITE_ -> lido apenas no servidor, via process.env dentro do handler.
# ==========================================================================

# --- Backend PostgreSQL (Supabase) — expostos ao navegador -----------------
# URL base da API do projeto de backend.
VITE_SUPABASE_URL=
# Chave publicável (anon). Pode ir ao navegador: o acesso é limitado por
# Row Level Security. Não substitua pela chave de serviço.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Identificador do projeto de backend. Usado por ferramentas de tipo.
VITE_SUPABASE_PROJECT_ID=

# --- Backend PostgreSQL — somente servidor --------------------------------
# Mesmos valores acima, na forma lida durante a renderização no servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Chave de serviço. IGNORA Row Level Security: uso exclusivo em código de
# servidor confiável (webhook, operações administrativas). Se esta chave
# vazar, todo o banco fica exposto. Nunca prefixe com VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (provedor Z-API) — somente servidor -------------------------
# Identificador da instância de WhatsApp.
ZAPI_INSTANCE_ID=
# Token da instância. Compõe a URL de chamada da API.
ZAPI_TOKEN=
# Token de conta, enviado no cabeçalho Client-Token. Opcional em contas que
# não o exigem; obrigatório quando a segurança da conta está ativada.
ZAPI_CLIENT_TOKEN=

# --- Inteligência artificial (gateway de modelos) — somente servidor ------
# Chave do gateway usado pelo motor de conversa da enquete no WhatsApp.
LOVABLE_API_KEY=

# --- Aplicação ------------------------------------------------------------
# URL pública da aplicação, usada para montar os links enviados por WhatsApp
# (convite de enquete e captação). Sem barra ao final.
# Ex.: https://enquete.seudominio.com.br
PUBLIC_APP_URL=

# Ambiente de execução. Definido automaticamente pelo Vite em dev/build.
# NODE_ENV=development